---
import "@/styles/global.css";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-sans-devanagari/500.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { SITE } from "@/lib/site";
import { isRepoConfigured } from "@/lib/subscribe";
import { canonicalFor } from "@/lib/view";

interface Props {
  title: string;
  description?: string;
  /** Extra page-specific JSON-LD objects. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = SITE.description, jsonLd = [] } = Astro.props;
const canonical = canonicalFor(Astro.url.pathname);

const baseJsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    alternateName: [SITE.devanagari, "Sutradhar Indian Engineering Blogs"],
    url: SITE.url,
    description: SITE.description,
    inLanguage: "en-IN",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    description: SITE.oneLiner,
    // Entity consistency (GEO): only claim profiles that actually exist.
    sameAs: SITE.sameAs.filter((u) => isRepoConfigured(u) || !u.includes("github.com")),
  },
];
const allJsonLd = [...baseJsonLd, ...jsonLd];

/** JSON-LD payload with < and > escaped — a `</script>` inside feed-sourced titles must never terminate the block. */
function safeJsonLd(object: Record<string, unknown>): string {
  return JSON.stringify(object).replace(/</g, "\\u003c").replace(/>/g, "\\u003e");
}
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title={`${SITE.name} JSON Feed`} href="/feed.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem("theme");
        } catch (e) {}
        if (!t) t = window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>
    {allJsonLd.map((object) => <script type="application/ld+json" set:html={safeJsonLd(object)} />)}
  </head>
  <body>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
