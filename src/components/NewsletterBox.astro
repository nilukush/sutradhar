---
import { SITE } from "@/lib/site";
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class={`newsletter ${compact ? "compact" : ""}`}>
  <p class="eyebrow">The weekly thread</p>
  <h2 class="title">India's engineering stories, in your inbox</h2>
  <p class="body">
    One email a week with everything Indian engineering teams published — the same thread as the
    site, delivered. No spam, unsubscribe anytime.
  </p>
  <div class="form">
    <!--
      Embed slot: paste your provider's embed code here (beehiiv / Kit / MailerLite free tiers
      all provide one). Until then we point readers at the newsletter page and RSS.
    -->
    <a class="button" href="/newsletter">Subscribe →</a>
    <span class="alt">or <a href="/rss.xml">follow via RSS</a></span>
  </div>
</section>

<style>
  .newsletter {
    background: var(--paper-sunk);
    border: 1px solid var(--line);
    border-top: 3px solid var(--saffron);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-3);
    max-width: 720px;
    margin-inline: auto;
  }
  .compact {
    padding: var(--space-5);
  }
  .title {
    font-size: var(--fs-xl);
  }
  .body {
    color: var(--ink-soft);
    margin: 0;
  }
  .form {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .button {
    display: inline-block;
    background: var(--saffron);
    color: #fff;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: var(--radius-sm);
  }
  .button:hover {
    background: var(--saffron-deep);
    text-decoration: none;
  }
  .alt {
    color: var(--ink-faint);
    font-size: var(--fs-sm);
  }
</style>
