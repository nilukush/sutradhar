---
import SubscribeForm from "@/components/SubscribeForm.astro";
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class={`newsletter ${compact ? "compact" : ""}`}>
  <p class="eyebrow">The weekly thread</p>
  <h2 class="title">India's engineering stories, in your inbox</h2>
  <p class="body">
    One email a week with everything Indian engineering teams published — the same thread as the
    site, delivered. No spam, unsubscribe anytime.
  </p>
  <SubscribeForm />
</section>

<style>
  .newsletter {
    background: var(--paper-sunk);
    border: 1px solid var(--line);
    border-top: 3px solid var(--saffron);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-3);
    max-width: 720px;
    margin-inline: auto;
  }
  .compact {
    padding: var(--space-5);
  }
  .title {
    font-size: var(--fs-xl);
  }
  .body {
    color: var(--ink-soft);
    margin: 0;
  }
</style>
