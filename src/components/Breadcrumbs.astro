---
import { SITE } from "@/lib/site";
import { safeJsonLd } from "@/lib/jsonld";

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
  /** Absolute canonical of the current page — last breadcrumb. */
  currentUrl: string;
}
const { crumbs, currentUrl } = Astro.props;

// Only ancestor crumbs get absolute `item` URLs; the current page appears once, last.
const ancestors = crumbs.filter((c) => c.href);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    ...ancestors.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.label,
      item: new URL(c.href!, SITE.url).toString(),
    })),
    {
      "@type": "ListItem",
      position: ancestors.length + 1,
      name: crumbs[crumbs.length - 1]?.label ?? "",
      item: currentUrl,
    },
  ],
};
---

<nav aria-label="Breadcrumb" class="crumbs">
  {crumbs.map((c, i) => (
    <span>
      {i > 0 && <span class="sep" aria-hidden="true">›</span>}
      {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
    </span>
  ))}
</nav>
<script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />

<style>
  .crumbs {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-faint);
    margin-bottom: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .sep {
    margin: 0 2px;
  }
</style>
