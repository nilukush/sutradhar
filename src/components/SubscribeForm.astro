---
import { subscribeOptions, isRepoConfigured } from "@/lib/subscribe";
import { SITE } from "@/lib/site";

/**
 * The subscribe control. With the default github-issue provider and a
 * configured repo it renders a real no-JS GET form: GitHub opens the
 * subscribe.yml issue template pre-filled with the entered email.
 * While the repo URL is still a placeholder (or a hosted provider is chosen),
 * it degrades to a working link — never a dead button.
 */
const options = subscribeOptions();
const repoReady = isRepoConfigured();
const showForm = options.provider === "github-issue" && repoReady;
// Never render an empty href — that links to the current page (the original bug).
const href = showForm
  ? undefined
  : options.provider === "beehiiv-hosted"
    ? options.href || options.fallbacks.rss
    : options.fallbacks.rss;
const fallbackLabel =
  options.provider === "beehiiv-hosted"
    ? "Subscribe with email →"
    : "Follow via RSS until the repo is live →";
---

{showForm ? (
  <form class="form" method="get" action={options.action}>
    <input type="hidden" name="template" value={options.fields.template} />
    <input type="hidden" name="title" value={options.fields.title} />
    <label class="visually-hidden" for="subscribe-email">Email address</label>
    <input
      id="subscribe-email"
      class="input"
      type="email"
      name="body"
      required
      placeholder="you@example.com"
      title="Enter your email — GitHub opens a pre-filled subscribe issue"
    />
    <button class="button" type="submit">Subscribe <span aria-hidden="true">→</span></button>
  </form>
) : (
  <div class="form">
    <a class="button" href={href}>{fallbackLabel}</a>
  </div>
)}
<p class="alt">
  Prefer a feed? <a href="/rss.xml">RSS</a> · <a href="/feed.json">JSON Feed</a>
  {options.provider === "github-issue" && repoReady && <span> · subscribe opens a pre-filled GitHub issue (no signup needed)</span>}
</p>

<style>
  .form {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .input {
    flex: 1 1 220px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--fs-base);
  }
  .input:focus {
    outline: 2px solid var(--saffron);
    outline-offset: 1px;
  }
  .button {
    display: inline-block;
    background: var(--saffron);
    color: #fff;
    font-weight: 600;
    font-family: var(--font-body);
    font-size: var(--fs-base);
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
  }
  .button:hover {
    background: var(--saffron-deep);
  }
  .alt {
    color: var(--ink-faint);
    font-size: var(--fs-sm);
    margin: var(--space-2) 0 0;
  }
</style>
