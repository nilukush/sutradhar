---
import Logo from "@/components/Logo.astro";
import { SITE } from "@/lib/site";

const nav = [
  { href: "/search", label: "Search" },
  { href: "/articles", label: "Latest" },
  { href: "/topics", label: "Topics" },
  { href: "/sources", label: "Sources" },
  { href: "/digest", label: "Digests" },
  { href: "/about", label: "About" },
];
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand thread-link" aria-label={`${SITE.name} home`}>
      <Logo size={26} />
      <span class="brand-name">{SITE.name}</span>
      <span class="brand-deva deva" lang="hi" aria-hidden="true">सूत्रधार</span>
    </a>

    <details class="menu" data-menu>
      <summary aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </summary>
      <nav aria-label="Primary" class="nav">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>

    <nav aria-label="Primary" class="nav nav-desktop">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="actions">
      <a href="/rss.xml" class="rss" aria-label="RSS feed" title="RSS feed">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9h3A12 12 0 0 0 4 8v3zm0-7a16 16 0 0 1 16 16h3A19 19 0 0 0 4 1v3zm2 13a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"></path>
        </svg>
      </a>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 60px;
  }
  .menu {
    display: none;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-md);
  }
  .brand-deva {
    color: var(--ink-faint);
    font-size: var(--fs-xs);
    transform: translateY(1px);
  }
  .nav {
    display: flex;
    gap: var(--space-4);
    margin-left: auto;
  }
  .nav a {
    color: var(--ink-soft);
    font-size: var(--fs-sm);
    font-weight: 500;
    padding: 4px 0;
  }
  .nav a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .rss {
    display: inline-flex;
    padding: 8px;
    border-radius: var(--radius-sm);
    color: var(--ink-soft);
  }
  .rss:hover {
    color: var(--saffron);
  }
  .theme-toggle {
    display: inline-flex;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--saffron);
    border-color: var(--saffron);
  }
  :global([data-theme="dark"]) .icon-sun {
    display: none;
  }
  :global([data-theme="light"]) .icon-moon,
  :global(:root:not([data-theme="dark"])) .icon-moon {
    display: none;
  }
  @media (max-width: 720px) {
    .nav-desktop {
      display: none;
    }
    .menu {
      display: block;
      margin-left: auto;
      position: relative;
    }
    .menu summary {
      display: inline-flex;
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: var(--paper-raised);
      color: var(--ink-soft);
      cursor: pointer;
      list-style: none;
    }
    .menu summary::-webkit-details-marker {
      display: none;
    }
    .menu[open] summary {
      color: var(--saffron);
      border-color: var(--saffron);
    }
    .menu .nav {
      position: absolute;
      top: calc(100% + var(--space-2));
      left: 0;
      z-index: 60;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-pop);
      padding: var(--space-4);
      min-width: 160px;
    }
    .brand-deva {
      display: none;
    }
  }
</style>
