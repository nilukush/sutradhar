---
import type { Page } from "astro";
import Base from "@/layouts/Base.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SourceBadge from "@/components/SourceBadge.astro";
import { TOPIC_LABELS, articlesForSource, canonicalFor, hostOf } from "@/lib/view";
import { absoluteReadHref } from "@/lib/read";
import { SOURCES } from "@/data/sources";
import type { Article } from "@/lib/schema";
import { SITE } from "@/lib/site";

const PAGE_SIZE = 48;

export async function getStaticPaths({ paginate }) {
  // Paginated per-source archive (audit P3-14: hubs capped at 48 with no way
  // deeper). NB: pageSize must be a literal — the prerender bundle does not
  // carry module consts into getStaticPaths.
  return SOURCES.flatMap((source) =>
    paginate(articlesForSource(source.id), {
      params: { company: source.id },
      props: { source },
      pageSize: 48,
    }),
  );
}

interface Props {
  source: (typeof SOURCES)[number];
  page: Page<Article>;
}
const { source, page } = Astro.props;
const title =
  page.currentPage > 1
    ? `${source.name} engineering blog — stories (page ${page.currentPage}) — ${SITE.name}`
    : `${source.name} engineering blog — stories — ${SITE.name}`;
const description = `Every engineering article ${source.name} has published, aggregated by ${SITE.name}: ${page.total} stories${page.currentPage > 1 ? ` — page ${page.currentPage}` : ""}.`;

const itemList = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${source.name} engineering stories`,
  url: canonicalFor(Astro.url.pathname),
  isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: page.data.length,
    itemListElement: page.data.map((a: Article, i: number) => ({
      "@type": "ListItem",
      position: (page.currentPage - 1) * PAGE_SIZE + i + 1,
      url: absoluteReadHref(a),
      name: a.title,
    })),
  },
};
---

<Base title={title} description={description} jsonLd={[itemList]} searchable={false}>
  <div class="container section">
    <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Sources", href: "/sources" }, { label: source.name }]} currentUrl={canonicalFor(Astro.url.pathname)} />
    <header class="head">
      <SourceBadge sourceId={source.id} size={48} />
      <div>
        <h1>{source.name} engineering</h1>
        <p class="meta">
          {page.total} stories
          {source.dormant && " · no recent posts"}
          {source.region === "india-linked" && " · global company, India-based teams"}
          · <a href={source.siteUrl} rel="noopener" target="_blank">{hostOf(source.siteUrl)}</a>
        </p>
        <div class="pills">
          {source.topics.map((t) => <a class="mini" href={`/topics/${t}`}>{TOPIC_LABELS[t]}</a>)}
        </div>
      </div>
    </header>
    {source.notes && <p class="prose note">{source.notes}</p>}
    <div class="grid">
      {page.data.map((article) => <ArticleCard article={article} headingLevel="h2" />)}
    </div>

    <nav class="pagination" aria-label="Pagination">
      {page.url.prev && <a class="page-link" href={page.url.prev}>← Newer</a>}
      <span class="meta">Page {page.currentPage} / {page.lastPage}</span>
      {page.url.next && <a class="page-link" href={page.url.next}>Older →</a>}
    </nav>
  </div>
</Base>

<style>
  .section {
    padding: var(--space-7) 0;
  }
  .head {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .pills {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .mini {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    background: var(--teal-wash);
    color: var(--teal);
    padding: 3px 8px;
    border-radius: var(--radius-pill);
  }
  .note {
    margin-top: var(--space-4);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .pagination {
    margin-top: var(--space-7);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
  }
  .page-link {
    font-weight: 600;
    color: var(--saffron-deep);
  }
</style>
