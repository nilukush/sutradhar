---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SourceBadge from "@/components/SourceBadge.astro";
import TopicPill from "@/components/TopicPill.astro";
import { articleSlug, isExternalRead, readHref } from "@/lib/read";
import { ARTICLES, TOPIC_LABELS, canonicalFor, formatDate, hostOf, relativeTime, sourceOf } from "@/lib/view";
import type { Article } from "@/lib/schema";
import { SITE } from "@/lib/site";

export async function getStaticPaths() {
  // Sources with excerptLimit 0 opted out of in-site reading pages.
  return ARTICLES.filter((a) => !isExternalRead(a)).map((article) => ({
    params: { slug: articleSlug(article) },
    props: { article },
  }));
}

interface Props {
  article: Article;
}
const { article } = Astro.props;
const source = sourceOf(article);
const sourceName = source?.name ?? article.sourceId;
const body = article.content || article.excerpt;
const truncated = article.content.endsWith("…") || !article.content;

const sameSource = ARTICLES.filter(
  (a) => a.sourceId === article.sourceId && a.id !== article.id && !isExternalRead(a),
).slice(0, 3);
const sameTopic = ARTICLES.filter(
  (a) => a.id !== article.id && a.sourceId !== article.sourceId && !isExternalRead(a) && a.topics.some((t) => article.topics.includes(t)),
).slice(0, 4);

const selfUrl = canonicalFor(`/read/${articleSlug(article)}`);
const description = `${article.excerpt} — by ${sourceName}${article.authors.length ? ` (${article.authors.join(", ")})` : ""}.`;

const newsArticle = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: article.title,
  description: article.excerpt,
  image: SITE.ogImage,
  datePublished: article.publishedAt,
  // The aggregator never edits sourced content — modified tracks publication.
  dateModified: article.publishedAt,
  url: selfUrl,
  isBasedOn: article.url,
  author: article.authors.map((name) => ({ "@type": "Person", name })),
  publisher: {
    "@type": "Organization",
    name: sourceName,
    ...(source ? { url: source.siteUrl } : {}),
  },
  mainEntityOfPage: selfUrl,
  articleSection: article.topics.map((t) => TOPIC_LABELS[t] ?? t),
};
---

<Base
  title={`${article.title} — ${sourceName} — ${SITE.name}`}
  description={description}
  jsonLd={[newsArticle]}
  ogType="article"
  publishedTime={article.publishedAt}
>
  <article class="container section">
    <Breadcrumbs
      crumbs={[
        { label: "Home", href: "/" },
        { label: sourceName, href: `/sources/${article.sourceId}` },
        { label: article.title },
      ]}
      currentUrl={selfUrl}
    />

    <header class="head">
      <div class="byline">
        <SourceBadge sourceId={article.sourceId} size={36} />
        <div>
          <a class="src" href={`/sources/${article.sourceId}`}>{sourceName}</a>
          <p class="meta">
            <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
            <span> · {relativeTime(article.publishedAt)}</span>
            {article.authors.length > 0 && <span> · {article.authors.join(", ")}</span>}
          </p>
        </div>
      </div>
      <h1>{article.title}</h1>
      <div class="pills">
        {article.topics.map((t) => <TopicPill topic={t} />)}
      </div>
    </header>

    <div class="body prose">
      <p>{body}</p>
      {truncated && (
        <p class="continuation">
          This is an excerpt. The full article continues at {sourceName}.
        </p>
      )}
    </div>

    <aside class="cta" aria-label="Original article">
      <p class="eyebrow">Read the original</p>
      <p class="cta-note">
        Sutradhar weaves threads, it doesn't reprint them — the full story lives with its author.
      </p>
      <a class="button" href={article.url} rel="noopener" target="_blank">
        Continue reading on {hostOf(article.url)} <span aria-hidden="true">↗</span>
      </a>
      {article.hn && (
        <a class="hn-link" href={`https://news.ycombinator.com/item?id=${article.hn.storyId}`} rel="noopener" target="_blank">
          ▲ Discussed on Hacker News — {article.hn.points} points · {article.hn.comments} comments
        </a>
      )}
      <span class="meta cta-host">{article.url}</span>
    </aside>

    {sameSource.length > 0 && (
      <section class="related">
        <h2>More from {sourceName}</h2>
        <ul>
          {sameSource.map((a) => (
            <li><a class="thread-link" href={readHref(a)}>{a.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {sameTopic.length > 0 && (
      <section class="related">
        <h2>Related on {article.topics.map((t) => TOPIC_LABELS[t] ?? t).join(", ")}</h2>
        <ul>
          {sameTopic.map((a) => (
            <li>
              <a class="thread-link" href={readHref(a)}>{a.title}</a>
              <span class="meta"> · {sourceOf(a)?.name ?? a.sourceId}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>

<style>
  .section {
    padding: var(--space-7) 0;
    max-width: 820px;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .src {
    font-weight: 600;
    color: var(--ink);
    font-size: var(--fs-md);
  }
  .byline .meta {
    margin: 2px 0 0;
  }
  h1 {
    font-size: var(--fs-2xl);
    margin-bottom: var(--space-4);
  }
  .pills {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  .body {
    font-size: var(--fs-md);
  }
  .body p {
    margin: 0 0 var(--space-4);
  }
  .continuation {
    color: var(--ink-faint);
    font-style: italic;
  }
  .cta {
    margin-top: var(--space-6);
    background: var(--paper-sunk);
    border: 1px solid var(--line);
    border-top: 3px solid var(--saffron);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .cta-note {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-sm);
  }
  .button {
    display: inline-block;
    background: var(--saffron);
    color: #fff;
    font-weight: 600;
    padding: 12px 22px;
    border-radius: var(--radius-sm);
    margin-top: var(--space-2);
  }
  .button:hover {
    background: var(--saffron-deep);
    text-decoration: none;
  }
  .cta-host {
    word-break: break-all;
  }
  .hn-link {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--saffron-deep);
  }
  .related {
    margin-top: var(--space-7);
  }
  .related h2 {
    font-size: var(--fs-lg);
    margin-bottom: var(--space-3);
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .related a {
    color: var(--ink);
    font-weight: 500;
  }
</style>
