---
import type { Page } from "astro";
import Base from "@/layouts/Base.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import NewsletterBox from "@/components/NewsletterBox.astro";
import { TOPIC_DESCRIPTIONS, TOPIC_LABELS, articlesForTopic, canonicalFor, topicsWithCounts } from "@/lib/view";
import { absoluteReadHref } from "@/lib/read";
import { TOPICS } from "@/lib/schema";
import type { Article } from "@/lib/schema";
import { SITE } from "@/lib/site";

const PAGE_SIZE = 48;

export async function getStaticPaths({ paginate }) {
  // Every topic with at least one story gets its own paginated run
  // (audit P3-14: hub pages capped at 48 with no way deeper). NB: pageSize
  // must be a literal here — the prerender bundle does not carry module
  // consts into getStaticPaths.
  const withArticles = new Set(topicsWithCounts().map((t) => t.topic));
  return TOPICS.filter((t) => withArticles.has(t)).flatMap((topic) =>
    paginate(articlesForTopic(topic), {
      params: { topic },
      props: { topic },
      pageSize: 48,
    }),
  );
}

interface Props {
  topic: (typeof TOPICS)[number];
  page: Page<Article>;
}
const { topic, page } = Astro.props;
const label = TOPIC_LABELS[topic];
const title =
  page.currentPage > 1
    ? `${label} — Indian engineering stories (page ${page.currentPage}) — ${SITE.name}`
    : `${label} — Indian engineering stories — ${SITE.name}`;
const description = `${TOPIC_DESCRIPTIONS[topic]} ${page.total} stories from Indian engineering teams${page.currentPage > 1 ? ` — page ${page.currentPage}` : ""}.`;

const itemList = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${label} — Indian engineering stories`,
  url: canonicalFor(Astro.url.pathname),
  isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: page.data.length,
    itemListElement: page.data.map((a: Article, i: number) => ({
      "@type": "ListItem",
      position: (page.currentPage - 1) * PAGE_SIZE + i + 1,
      url: absoluteReadHref(a),
      name: a.title,
    })),
  },
};
---

<Base title={title} description={description} jsonLd={[itemList]}>
  <div class="container section">
    <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Topics", href: "/topics" }, { label }]} currentUrl={canonicalFor(Astro.url.pathname)} />
    <h1>{label}</h1>
    <p class="prose">{TOPIC_DESCRIPTIONS[topic]}</p>
    <p class="meta">{page.total} stories</p>
    <div class="grid">
      {page.data.map((article) => <ArticleCard article={article} headingLevel="h2" />)}
    </div>

    <nav class="pagination" aria-label="Pagination">
      {page.url.prev && <a class="page-link" href={page.url.prev}>← Newer</a>}
      <span class="meta">Page {page.currentPage} / {page.lastPage}</span>
      {page.url.next && <a class="page-link" href={page.url.next}>Older →</a>}
    </nav>

    <div class="newsletter-wrap">
      <NewsletterBox compact />
    </div>
  </div>
</Base>

<style>
  .section {
    padding: var(--space-7) 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .pagination {
    margin-top: var(--space-7);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
  }
  .page-link {
    font-weight: 600;
    color: var(--saffron-deep);
  }
  .newsletter-wrap {
    margin-top: var(--space-7);
  }
</style>
