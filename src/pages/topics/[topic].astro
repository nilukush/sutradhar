---
import Base from "@/layouts/Base.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import NewsletterBox from "@/components/NewsletterBox.astro";
import { TOPIC_DESCRIPTIONS, TOPIC_LABELS, articlesForTopic, canonicalFor, topicsWithCounts } from "@/lib/view";
import { absoluteReadHref } from "@/lib/read";
import { TOPICS } from "@/lib/schema";
import { SITE } from "@/lib/site";

export async function getStaticPaths() {
  const withArticles = new Set(topicsWithCounts().map((t) => t.topic));
  return TOPICS.filter((t) => withArticles.has(t)).map((topic) => ({
    params: { topic },
    props: { topic },
  }));
}

interface Props {
  topic: (typeof TOPICS)[number];
}
const { topic } = Astro.props;
const label = TOPIC_LABELS[topic];
const articles = articlesForTopic(topic);
const description = `${TOPIC_DESCRIPTIONS[topic]} ${articles.length} stories from Indian engineering teams.`;

const itemList = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${label} — Indian engineering stories`,
  url: canonicalFor(`/topics/${topic}`),
  isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: articles.length,
    itemListElement: articles.slice(0, 50).map((a, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: absoluteReadHref(a),
      name: a.title,
    })),
  },
};
---

<Base title={`${label} — Indian engineering stories — ${SITE.name}`} description={description} jsonLd={[itemList]}>
  <div class="container section">
    <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Topics", href: "/topics" }, { label }]} currentUrl={canonicalFor(Astro.url.pathname)} />
    <h1>{label}</h1>
    <p class="prose">{TOPIC_DESCRIPTIONS[topic]}</p>
    <p class="meta">{articles.length} stories</p>
    <div class="grid">
      {articles.slice(0, 48).map((article) => <ArticleCard article={article} />)}
    </div>
    {articles.length > 48 && (
      <p class="meta more">Showing the 48 newest of {articles.length} — browse <a href="/articles">all stories</a>.</p>
    )}
    <div class="newsletter-wrap">
      <NewsletterBox compact />
    </div>
  </div>
</Base>

<style>
  .section {
    padding: var(--space-7) 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .more {
    margin-top: var(--space-5);
  }
  .newsletter-wrap {
    margin-top: var(--space-7);
  }
</style>
