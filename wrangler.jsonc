{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the existing deployed Worker so `wrangler deploy` updates it
  // (sutradhar.nilukush.workers.dev) instead of creating a new one.
  "name": "sutradhar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./dist"
  },
  // keep_vars preserves dashboard-set plain variables across config-driven
  // deploys (secrets always persist; this protects text-type vars).
  "keep_vars": true,
  "vars": {
    "BREVO_LIST_NAME": "Sutradhar"
  }
}
