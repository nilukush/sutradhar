{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the existing deployed Worker so `wrangler deploy` updates it
  // (sutradhar.nilukush.workers.dev) instead of creating a new one.
  "name": "sutradhar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Route every request through the Worker first so its http→https
    // redirect covers asset-backed URLs too, not just dynamic paths (B2).
    "run_worker_first": true,
    // Unknown paths serve the built 404 page with status 404 — with the
    // default "none" the Worker's ASSETS.fetch throws and every miss becomes
    // a 500 (error 1101), e.g. /articles/<beyond-last> (SEO-GEO-AUDIT A1).
    "not_found_handling": "404-page",
    // Serve the slashless URLs that every canonical, sitemap entry, feed item
    // and llms.txt link already use; "/articles/" 308s to "/articles" instead
    // of the reverse, so canonical targets stop pointing at redirects (B1).
    "html_handling": "drop-trailing-slash"
  },
  // keep_vars preserves dashboard-set plain variables across config-driven
  // deploys (secrets always persist; this protects text-type vars).
  "keep_vars": true,
  "vars": {
    "BREVO_LIST_NAME": "Sutradhar"
  }
}
